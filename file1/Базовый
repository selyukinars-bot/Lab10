<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Конвертер температур</title>
    <link rel="stylesheet" href="./styles/style.css">
</head>
<body>

    <div class="container">
        <h1>Конвертер температур</h1>

        <label for="temperature">Введите температуру:</label>
        <input type="number" id="temperature" placeholder="Например, 25">

        <label for="conversion">Выберите преобразование:</label>
        <select id="conversion">
            <option value="cToF">Цельсий → Фаренгейт</option>
            <option value="fToC">Фаренгейт → Цельсий</option>
            <option value="cToK">Цельсий → Кельвин</option>
        </select>

        <button id="convert">Конвертировать</button>

        <p id="result">Результат появится здесь</p>
    </div>

    <script type="module" src="./src/main.js"></script>
</body>
</html>
