// Цельсий в Фаренгейт
export function celsiusToFahrenheit(celsius) {
    return (celsius * 9 / 5) + 32;
}

// Фаренгейт в Цельсий
export function fahrenheitToCelsius(fahrenheit) {
    return (fahrenheit - 32) * 5 / 9;
}

// Цельсий в Кельвин
export function celsiusToKelvin(celsius) {
    return celsius + 273.15;
}
------------------------------------
import {
    celsiusToFahrenheit,
    fahrenheitToCelsius,
    celsiusToKelvin
} from "./modules/temperature.js";

const input = document.querySelector("#temperature");
const conversion = document.querySelector("#conversion");
const button = document.querySelector("#convert");
const result = document.querySelector("#result");

button.addEventListener("click", () => {
    const value = Number(input.value);

    if (input.value.trim() === "" || !Number.isFinite(value)) {
        result.textContent = "Введите корректную температуру!";
        return;
    }

    let answer;

    switch (conversion.value) {
        case "cToF":
            answer = celsiusToFahrenheit(value);
            result.textContent = `${answer.toFixed(2)} °F`;
            break;

        case "fToC":
            answer = fahrenheitToCelsius(value);
            result.textContent = `${answer.toFixed(2)} °C`;
            break;

        case "cToK":
            answer = celsiusToKelvin(value);

            if (answer < 0) {
                result.textContent = "Температура не может быть ниже абсолютного нуля!";
                return;
            }

            result.textContent = `${answer.toFixed(2)} K`;
            break;
    }
});
