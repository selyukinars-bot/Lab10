<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мини-CRM клиентов</title>
    <link rel="stylesheet" href="./styles/style.css">
</head>
<body>

    <div class="container">
        <h1>Мини-CRM клиентов</h1>

        <form id="clientForm">
            <input type="hidden" id="clientId">

            <input type="text" id="name" placeholder="Имя клиента">
            <input type="tel" id="phone" placeholder="Номер телефона">
            <input type="email" id="email" placeholder="Электронная почта">

            <button type="submit" id="submitButton">
                Добавить клиента
            </button>

            <p id="message"></p>
        </form>

        <h2>Список клиентов</h2>

        <input
            type="search"
            id="searchInput"
            placeholder="Поиск клиента..."
        >

        <div id="clientList"></div>

        <p id="counter">Всего клиентов: 0</p>
    </div>

    <script type="module" src="./src/main.js"></script>
</body>
</html>
-----------------------------------------------
let clients = [];

export function setClients(data) {
    clients = data;
}

export function getClients() {
    return clients;
}

// Добавление клиента
export function addClient(client) {
    const newClient = {
        id: crypto.randomUUID(),
        ...client
    };

    clients.push(newClient);
    return newClient;
}

// Редактирование клиента
export function updateClient(id, updatedData) {
    clients = clients.map(client =>
        client.id === id
            ? { ...client, ...updatedData }
            : client
    );
}

// Удаление клиента
export function deleteClient(id) {
    clients = clients.filter(client => client.id !== id);
}

// Получение одного клиента
export function getClientById(id) {
    return clients.find(client => client.id === id);
}
-----------------------------------------------
export function validateClient(name, phone, email) {
    const errors = [];

    if (name.trim().length < 2) {
        errors.push("Имя должно содержать минимум 2 символа");
    }

    if (!/^\+?[0-9\s()-]{7,20}$/.test(phone.trim())) {
        errors.push("Введите корректный номер телефона");
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) {
        errors.push("Введите корректную электронную почту");
    }

    return errors;
}
--------------------------------------------------------
export function searchClients(clients, query) {
    const searchText = query.toLowerCase().trim();

    if (!searchText) {
        return clients;
    }

    return clients.filter(client =>
        client.name.toLowerCase().includes(searchText) ||
        client.phone.toLowerCase().includes(searchText) ||
        client.email.toLowerCase().includes(searchText)
    );
}
--------------------------------------------------------------
const STORAGE_KEY = "crm_clients";

// Сохранение клиентов
export function saveClients(clients) {
    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(clients)
    );
}

// Загрузка клиентов
export function loadClients() {
    try {
        const data = localStorage.getItem(STORAGE_KEY);
        const clients = data ? JSON.parse(data) : [];

        return Array.isArray(clients) ? clients : [];
    } catch (error) {
        console.error("Ошибка загрузки данных:", error);
        return [];
    }
}
---------------------------------------------------------------------
export function renderClients(clients) {
    const clientList = document.querySelector("#clientList");
    const counter = document.querySelector("#counter");

    clientList.innerHTML = "";

    if (clients.length === 0) {
        clientList.textContent = "Клиенты не найдены";
    }

    clients.forEach(client => {
        const card = document.createElement("div");
        card.className = "client-card";

        const name = document.createElement("h3");
        name.textContent = client.name;

        const phone = document.createElement("p");
        phone.textContent = "Телефон: " + client.phone;

        const email = document.createElement("p");
        email.textContent = "Email: " + client.email;

        const editButton = document.createElement("button");
        editButton.textContent = "Изменить";
        editButton.dataset.action = "edit";
        editButton.dataset.id = client.id;

        const deleteButton = document.createElement("button");
        deleteButton.textContent = "Удалить";
        deleteButton.className = "delete-button";
        deleteButton.dataset.action = "delete";
        deleteButton.dataset.id = client.id;

        card.append(name, phone, email, editButton, deleteButton);
        clientList.appendChild(card);
    });

    counter.textContent = `Всего клиентов: ${clients.length}`;
}
