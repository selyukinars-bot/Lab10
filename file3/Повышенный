import {
    setClients,
    getClients,
    addClient,
    updateClient,
    deleteClient,
    getClientById
} from "./modules/clientModel.js";

import { validateClient } from "./modules/validation.js";
import { searchClients } from "./modules/search.js";
import { saveClients, loadClients } from "./modules/storage.js";
import { renderClients } from "./modules/clientRenderer.js";

const form = document.querySelector("#clientForm");
const nameInput = document.querySelector("#name");
const phoneInput = document.querySelector("#phone");
const emailInput = document.querySelector("#email");
const clientIdInput = document.querySelector("#clientId");
const searchInput = document.querySelector("#searchInput");
const message = document.querySelector("#message");
const submitButton = document.querySelector("#submitButton");

// Загрузка сохранённых клиентов
setClients(loadClients());

// Обновление интерфейса
function refresh() {
    const clients = getClients();
    const query = searchInput.value;

    const filteredClients = searchClients(clients, query);

    renderClients(filteredClients);
    saveClients(clients);
}

// Добавление и редактирование
form.addEventListener("submit", (event) => {
    event.preventDefault();

    const name = nameInput.value.trim();
    const phone = phoneInput.value.trim();
    const email = emailInput.value.trim();

    const errors = validateClient(name, phone, email);

    if (errors.length > 0) {
        message.textContent = errors.join(". ");
        return;
    }

    const clientData = { name, phone, email };
    const id = clientIdInput.value;

    if (id) {
        updateClient(id, clientData);
        message.textContent = "Данные клиента обновлены!";
    } else {
        addClient(clientData);
        message.textContent = "Клиент успешно добавлен!";
    }

    form.reset();
    clientIdInput.value = "";
    submitButton.textContent = "Добавить клиента";

    refresh();
});

// Поиск клиентов
searchInput.addEventListener("input", refresh);

// Обработка кнопок изменения и удаления
document.querySelector("#clientList").addEventListener("click", (event) => {
    const button = event.target.closest("button[data-action]");

    if (!button) return;

    const id = button.dataset.id;

    if (button.dataset.action === "delete") {
        deleteClient(id);
        message.textContent = "Клиент удалён!";
        refresh();
    }

    if (button.dataset.action === "edit") {
        const client = getClientById(id);

        if (!client) return;

        clientIdInput.value = client.id;
        nameInput.value = client.name;
        phoneInput.value = client.phone;
        emailInput.value = client.email;

        submitButton.textContent = "Сохранить изменения";
        message.textContent = "Редактирование клиента";
    }
});

// Первоначальное отображение
refresh();
